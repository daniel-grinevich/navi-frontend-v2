# Copy to `.env.staging`, then run `pnpm dev:staging`.
# Points the dev server at the Tailscale-exposed staging backend so you can
# develop the frontend without running the backend locally.
# Requires this machine to be on the tailnet (Tailscale up).

# Empty base -> apiClient/WebSocket use relative URLs that the dev-server proxy
# below forwards to staging. Do not set this to an absolute URL in proxy mode.
VITE_BASE_URL=

# Where the dev server proxies /api and /ws (staging Django, Tailscale ingress).
VITE_PROXY_TARGET=https://navi-staging.tailf9a785.ts.net

# Origin/Referer the proxy presents to Django so CSRF_TRUSTED_ORIGINS passes.
VITE_PROXY_ORIGIN=https://navi-ui-staging.tailf9a785.ts.net

VITE_ENVIRONMENT=dev

# Flip to "true" once the backend OAuth endpoints are live to show social sign-in.
VITE_OAUTH_ENABLED=false

# Stripe publishable key for staging (needed only for checkout).
VITE_STRIPE_PUBLISHABLE_KEY=
